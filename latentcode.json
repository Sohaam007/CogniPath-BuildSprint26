{
  "version": 1,
  "project": {
    "name": "cognipath",
    "type": "fastapi"
  },
  "runtime": {
    "language": "python",
    "version": "3.11"
  },
  "deployment": {
    "start_command": "uvicorn api.main:app --host 0.0.0.0 --port 8000",
    "build_command": "pip install -r requirements.txt && cd c_engine && make",
    "env": {
      "PORT": "8000",
      "PYTHONUNBUFFERED": "1"
    }
  }
}